generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["typedSql"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Users {
  id            String          @id @default(cuid())
  email         String          @unique
  name          String
  password      String          @default("")
  roles         String[]        @default(["member"])
  playlists     Playlist[]
  photo         String          @default("")
  RefreshTokens RefreshTokens[]
  created_at    DateTime        @default(now()) @db.Timestamp(6)
  updated_at    DateTime        @updatedAt @db.Timestamp(6)
}

model Playlist {
  id           String         @id @default(cuid())
  name         String         @default("My Playlist")
  description  String?
  user         Users          @relation(fields: [user_id], references: [id])
  user_id      String
  created_at   DateTime       @default(now())
  photo        String         @default("")
  updated_at   DateTime       @updatedAt @db.Timestamp(6)
  PlaylistSong PlaylistSong[]
}

model PlaylistSong {
  id          String   @id @default(cuid())
  playlist    Playlist @relation(fields: [playlist_id], references: [id])
  playlist_id String
  song        Song     @relation(fields: [song_id], references: [id])
  song_id     String
}

model Song {
  id           String         @id @default(cuid())
  name         String         @default("defaultSong")
  author       Author         @relation(fields: [author_id], references: [id])
  author_id    String
  length       Int
  photo        String         @default("")
  created_at   DateTime       @default(now()) @db.Timestamp(6)
  updated_at   DateTime       @updatedAt @db.Timestamp(6)
  Albums       Albums         @relation(fields: [albumsId], references: [id])
  albumsId     String
  PlaylistSong PlaylistSong[]
}

model Author {
  id         String   @id @default(cuid())
  name       String
  genre      String
  bio        String?
  photo_url  String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  albums     Albums[]
  songs      Song[]
}

model Albums {
  id          String   @id @default(cuid())
  title       String
  artistId    String
  releaseDate DateTime
  cover_url   String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  author      Author   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  song        Song[]
}

model RefreshTokens {
  id           String   @id @default(cuid())
  token        String   @unique
  user         Users    @relation(fields: [user_id], references: [id])
  user_id      String
  expires_at   DateTime
  created_at   DateTime @default(now()) @db.Timestamp(6)
  updated_at   DateTime @updatedAt @db.Timestamp(6)
  refreshCount Int      @default(0)
}
